const vm = require('node:vm')
const { createRequire } = require('node:module')
const { readSource, translate } = require('./translate.js')

func bsrCommand(file):
  const { source, filePath } = readSource(file)
  const code = translate(source)
  const sandbox = { console, process, require: createRequire(filePath) }
  vm.runInNewContext(code, sandbox, { filename: filePath })
end

module.exports = { bsrCommand }
