const vm = require('node:vm')
const { createRequire } = require('node:module')
const { readSource, translate } = require('./translate.js')

function bsrCommand(file) {
  const { source, filePath } = readSource(file)
  const code = translate(source)
  vm.runInNewContext(code, {
    console,
    process,
    require: createRequire(filePath)
  }, { filename: filePath })
}

module.exports = { bsrCommand }
